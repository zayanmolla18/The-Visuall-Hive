---
// src/layouts/Layout.astro
export interface Props {
    title?: string;
}

const { title = "The Visual Hive | Creative Brand Strategy & Visual Design Agency" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    {/* We keep the original head but replace the title to use Astro props if needed, or just keep it all */}
    
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description"
        content="We craft polished brand identities, logos, marketing materials, and digital experiences that elevate businesses and connect with customers.">
    <link rel="icon" type="image/png" href="/favicon.png">

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style is:global>
        :root {
            --font-main: 'Plus Jakarta Sans', sans-serif;

            /* Premium Creative Theme */
            --bg-primary: #f8fafc;
            --bg-secondary: #f1f5f9;
            --surface: #ffffff;
            --text-main: #0f172a;
            --text-muted: #475569;

            --color-primary: #1e293b;
            --color-primary-light: #3b82f6;
            --accent: #d97706;
            /* Warm Amber */

            /* Gradients */
            --accent-gradient: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
            --primary-gradient: linear-gradient(135deg, #1e293b 0%, #334155 100%);
            --text-gradient: linear-gradient(135deg, #1e293b 0%, #475569 100%);
            --glow-gradient: linear-gradient(135deg, rgba(251, 191, 36, 0.15) 0%, rgba(217, 119, 6, 0.05) 100%);

            /* Borders & Shadows */
            --border-color: rgba(15, 23, 42, 0.08);
            --border-hover: rgba(217, 119, 6, 0.3);
            --border-focus: #d97706;

            --shadow-sm: 0 2px 4px rgba(15, 23, 42, 0.02);
            --shadow-md: 0 10px 30px -10px rgba(15, 23, 42, 0.05), 0 1px 2px rgba(15, 23, 42, 0.02);
            --shadow-lg: 0 20px 40px -15px rgba(15, 23, 42, 0.08), 0 1px 3px rgba(15, 23, 42, 0.03);
            --shadow-hover: 0 30px 60px -20px rgba(15, 23, 42, 0.12), 0 4px 6px rgba(15, 23, 42, 0.02);
            --shadow-glow: 0 0 24px rgba(217, 119, 6, 0.15);

            --radius-sm: 8px;
            --radius-md: 16px;
            --radius-lg: 24px;
            --radius-full: 9999px;

            /* Transitions */
            --transition-smooth: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
            --transition-fast: all 0.2s ease;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-main);
            background: var(--bg-primary);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        a {
            color: inherit;
            text-decoration: none;
            transition: var(--transition-fast);
        }

        button,
        input,
        textarea {
            font-family: inherit;
        }

        /* Utility Layouts */
        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 40px;
            width: 100%;
        }

        .section {
            padding: 120px 0;
            position: relative;
        }

        .section-header {
            text-align: center;
            max-width: 680px;
            margin: 0 auto 64px auto;
        }

        .section-tag {
            display: inline-block;
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--accent);
            margin-bottom: 12px;
        }

        .section-title {
            font-size: 2.5rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: var(--text-main);
            margin-bottom: 20px;
        }

        .section-desc {
            font-size: 1.1rem;
            color: var(--text-muted);
            line-height: 1.75;
        }

        /* Scroll Reveal Effect */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1), transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 16px 32px;
            border-radius: var(--radius-full);
            font-weight: 700;
            font-size: 0.95rem;
            transition: var(--transition-smooth);
            cursor: pointer;
            border: none;
        }

        .btn-primary {
            background: var(--accent-gradient);
            color: #ffffff;
            box-shadow: 0 8px 24px rgba(217, 119, 6, 0.2);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(217, 119, 6, 0.3);
        }

        .btn-secondary {
            background: var(--surface);
            border: 1px solid var(--border-color);
            color: var(--text-main);
        }

        .btn-secondary:hover {
            background: var(--bg-secondary);
            transform: translateY(-2px);
        }

        /* Header Navigation */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border-color);
            z-index: 1000;
            transition: var(--transition-fast);
        }

        header.scrolled {
            background: rgba(255, 255, 255, 0.95);
            box-shadow: var(--shadow-sm);
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 90px;
            transition: var(--transition-fast);
        }

        header.scrolled .nav-container {
            height: 76px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo img {
            height: 48px;
            width: auto;
            transition: var(--transition-smooth);
        }

        header.scrolled .logo img {
            height: 42px;
        }

        .logo h1 {
            font-size: 1.2rem;
            font-weight: 800;
            letter-spacing: -0.01em;
            color: var(--text-main);
        }

        nav.nav-desktop {
            display: flex;
            align-items: center;
            gap: 36px;
        }

        nav.nav-desktop a {
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--text-muted);
            position: relative;
            padding: 8px 0;
        }

        nav.nav-desktop a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--accent);
            transition: var(--transition-fast);
        }

        nav.nav-desktop a:hover {
            color: var(--text-main);
        }

        nav.nav-desktop a:hover::after {
            width: 100%;
        }

        nav.nav-desktop a.active-link {
            color: var(--text-main);
        }

        nav.nav-desktop a.active-link::after {
            width: 100%;
        }

        /* Mobile Hamburger & Overlay */
        .nav-toggle {
            display: none;
            flex-direction: column;
            justify-content: space-between;
            width: 24px;
            height: 18px;
            background: transparent;
            border: none;
            cursor: pointer;
            z-index: 1100;
        }

        .nav-toggle span {
            width: 100%;
            height: 2px;
            background-color: var(--text-main);
            border-radius: 2px;
            transition: var(--transition-smooth);
        }

        .nav-toggle.open span:nth-child(1) {
            transform: translateY(8px) rotate(45deg);
        }

        .nav-toggle.open span:nth-child(2) {
            opacity: 0;
        }

        .nav-toggle.open span:nth-child(3) {
            transform: translateY(-8px) rotate(-45deg);
        }

        .nav-drawer {
            position: fixed;
            top: 0;
            right: -100%;
            width: 300px;
            height: 100vh;
            background: var(--surface);
            box-shadow: -10px 0 40px rgba(15, 23, 42, 0.15);
            z-index: 1050;
            display: flex;
            flex-direction: column;
            padding: 120px 40px 40px 40px;
            gap: 28px;
            transition: right 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        }

        .nav-drawer.open {
            right: 0;
        }

        .nav-drawer a {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-main);
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 12px;
        }

        .nav-drawer a:hover {
            color: var(--accent);
            padding-left: 8px;
        }

        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(15, 23, 42, 0.4);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 1020;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.4s ease;
        }

        .overlay.open {
            opacity: 1;
            pointer-events: auto;
        }

        /* Hero Section */
        .hero {
            padding: 200px 0 120px 0;
            overflow: hidden;
            background: radial-gradient(circle at 80% 20%, rgba(251, 191, 36, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 10% 80%, rgba(59, 130, 246, 0.05) 0%, transparent 50%);
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 64px;
            align-items: center;
        }

        .hero-copy {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-tag {
            background: var(--glow-gradient);
            border: 1px solid var(--border-hover);
            color: var(--accent);
            padding: 8px 18px;
            border-radius: var(--radius-full);
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            margin-bottom: 24px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .hero-copy h2 {
            font-size: min(3.8rem, 5vw);
            line-height: 1.1;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: var(--text-main);
            margin-bottom: 24px;
        }

        .hero-copy h2 span {
            background: linear-gradient(135deg, #1e293b 30%, #fbbf24 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-copy p {
            font-size: 1.15rem;
            line-height: 1.8;
            color: var(--text-muted);
            margin-bottom: 36px;
            max-width: 580px;
        }

        .hero-actions {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 48px;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 20px;
            width: 100%;
        }

        .stat-badge {
            background: var(--surface);
            border: 1px solid var(--border-color);
            padding: 20px;
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            transition: var(--transition-smooth);
        }

        .stat-badge:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
            border-color: var(--border-hover);
        }

        .stat-number {
            display: block;
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 4px;
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .stat-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* Interactive Selected Work Preview */
        .hero-visual {
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            height: 460px;
        }

        .hero-glow-blob {
            position: absolute;
            width: 320px;
            height: 320px;
            background: radial-gradient(circle, rgba(251, 191, 36, 0.18) 0%, transparent 70%);
            z-index: 1;
            filter: blur(20px);
            animation: pulse-blob 8s infinite alternate;
        }

        .work-preview {
            position: relative;
            width: min(360px, 72vw);
            aspect-ratio: 1 / 1.05;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .work-preview-main {
            position: relative;
            width: 74%;
            padding: 18px;
            background: var(--surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
            transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.45s ease;
            z-index: 5;
        }

        .work-preview-main img,
        .work-preview-item img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.04));
        }

        .work-preview-stack {
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .work-preview-item {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 64%;
            padding: 12px;
            background: var(--surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-md);
            opacity: 0;
            transform: translate(-50%, -50%) scale(0.92);
            transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.35s ease;
        }

        .work-preview:hover .work-preview-main {
            transform: translateY(-6px) scale(1.02);
            box-shadow: var(--shadow-hover);
        }

        .work-preview:hover .work-preview-item {
            opacity: 1;
        }

        .work-preview:hover .item-1 {
            transform: translate(-112%, -36%) rotate(-12deg) scale(1);
            transition-delay: 0.04s;
        }

        .work-preview:hover .item-2 {
            transform: translate(-18%, -116%) rotate(7deg) scale(1);
            transition-delay: 0.12s;
        }

        .work-preview:hover .item-3 {
            transform: translate(95%, -28%) rotate(12deg) scale(1);
            transition-delay: 0.2s;
        }

        .work-preview:hover .item-4 {
            transform: translate(8%, 86%) rotate(-5deg) scale(1);
            transition-delay: 0.28s;
        }

        @media (max-width: 768px) {
            .hero-visual {
                height: 360px;
            }

            .work-preview {
                width: min(300px, 82vw);
            }

            .work-preview-main {
                width: 80%;
                padding: 14px;
            }

            .work-preview-item {
                width: 70%;
                padding: 10px;
            }
        }

        /* Marquee Section */
        .marquee-section {
            background: var(--color-primary);
            color: #ffffff;
            padding: 20px 0;
            overflow: hidden;
            white-space: nowrap;
            position: relative;
            display: flex;
            align-items: center;
            border-top: 1px solid rgba(255,255,255,0.1);
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .marquee-content {
            display: inline-flex;
            align-items: center;
            gap: 24px;
            animation: scroll-marquee 25s linear infinite;
            padding-right: 24px;
        }

        .marquee-content span {
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: 0.15em;
            text-transform: uppercase;
        }

        .marquee-content .dot {
            color: var(--accent);
            font-size: 1.5rem;
            line-height: 0;
        }

        @keyframes scroll-marquee {
            0% {
                transform: translateX(0);
            }
            100% {
                transform: translateX(calc(-50% - 12px)); /* -50% of content, minus half the gap */
            }
        }

        /* Portfolio Section */
        .portfolio-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 32px;
            margin-top: 24px;
        }

        .portfolio-card {
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            overflow: hidden;
            box-shadow: var(--shadow-md);
            transition: var(--transition-smooth);
            display: flex;
            flex-direction: column;
        }

        .portfolio-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-hover);
            border-color: var(--border-hover);
        }

        /* Canvas mockup background for full images */
        .portfolio-canvas {
            background: #f8fafc;
            height: 280px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            overflow: hidden;
            position: relative;
            border-bottom: 1px solid var(--border-color);
            transition: var(--transition-smooth);
        }

        .portfolio-card:hover .portfolio-canvas {
            background: #f1f5f9;
        }

        .portfolio-canvas img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transition: var(--transition-smooth);
        }

        .portfolio-card:hover .portfolio-canvas img {
            transform: scale(1.05);
        }

        .portfolio-info {
            padding: 28px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .portfolio-category {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 8px;
        }

        .portfolio-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 10px;
        }

        .portfolio-desc {
            font-size: 0.95rem;
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .portfolio-link {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--text-main);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: auto;
        }

        .portfolio-link i {
            transition: transform 0.2s ease;
        }

        .portfolio-card:hover .portfolio-link i {
            transform: translateX(4px);
        }

        /* Services Section */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 24px;
        }

        .service-card {
            background: var(--surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 32px;
            transition: var(--transition-smooth);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-height: 260px;
        }

        .service-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--accent-gradient);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        }

        .service-card:hover::before {
            transform: scaleX(1);
        }

        .service-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-hover);
            border-color: var(--border-hover);
        }

        .service-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 24px;
        }

        .service-icon {
            width: 52px;
            height: 52px;
            border-radius: var(--radius-md);
            display: grid;
            place-items: center;
            background: rgba(217, 119, 6, 0.08);
            color: var(--accent);
            font-size: 1.25rem;
            transition: var(--transition-smooth);
        }

        .service-card:hover .service-icon {
            background: var(--accent-gradient);
            color: #ffffff;
            transform: scale(1.05);
        }

        .service-index {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text-muted);
            opacity: 0.4;
        }

        .service-card h3 {
            font-size: 1.15rem;
            font-weight: 750;
            color: var(--text-main);
            margin-bottom: 12px;
            letter-spacing: -0.01em;
        }

        .service-card p {
            font-size: 0.95rem;
            color: var(--text-muted);
            line-height: 1.6;
        }

        /* Contact & Process Grid */
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 64px;
            align-items: start;
        }

        .contact-info-panel h3 {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 18px;
            letter-spacing: -0.02em;
        }

        .contact-info-panel p.intro {
            font-size: 1.05rem;
            color: var(--text-muted);
            margin-bottom: 40px;
            line-height: 1.7;
        }

        /* Process Steps Timeline */
        .process-timeline {
            display: flex;
            flex-direction: column;
            gap: 36px;
            margin-bottom: 48px;
        }

        .process-step {
            display: flex;
            gap: 20px;
            position: relative;
        }

        .process-step:not(:last-child)::after {
            content: '';
            position: absolute;
            left: 20px;
            top: 44px;
            bottom: -24px;
            width: 2px;
            background: var(--border-color);
        }

        .process-number {
            width: 42px;
            height: 42px;
            border-radius: var(--radius-full);
            background: var(--accent-gradient);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.9rem;
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(217, 119, 6, 0.2);
        }

        .process-content {
            padding-top: 6px;
        }

        .process-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 6px;
        }

        .process-desc {
            font-size: 0.95rem;
            color: var(--text-muted);
            line-height: 1.6;
        }

        /* Direct Info Links */
        .direct-links {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .direct-link-card {
            background: var(--surface);
            border: 1px solid var(--border-color);
            padding: 24px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            gap: 16px;
            box-shadow: var(--shadow-sm);
            transition: var(--transition-smooth);
        }

        .direct-link-card:hover {
            border-color: var(--border-hover);
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }

        .direct-icon {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--bg-secondary);
            color: var(--accent);
            display: grid;
            place-items: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .direct-info {
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .direct-label {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .direct-value {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-main);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* Form Container */
        .contact-form-container {
            background: var(--surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 48px;
            box-shadow: var(--shadow-lg);
        }

        .contact-form-container h4 {
            font-size: 1.4rem;
            font-weight: 800;
            margin-bottom: 24px;
            color: var(--text-main);
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .form-control {
            width: 100%;
            padding: 16px 20px;
            background: var(--bg-secondary);
            border: 1px solid transparent;
            border-radius: var(--radius-md);
            color: var(--text-main);
            font-size: 0.95rem;
            font-weight: 500;
            transition: var(--transition-smooth);
        }

        .form-control:focus {
            outline: none;
            background: var(--surface);
            border-color: var(--border-focus);
            box-shadow: var(--shadow-glow);
        }

        textarea.form-control {
            min-height: 150px;
            resize: vertical;
        }

        .form-status {
            margin-top: 16px;
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--accent);
            min-height: 24px;
        }

        .form-status.error {
            color: #dc2626;
        }

        /* Social Icons Block */
        .social-block {
            border-top: 1px solid var(--border-color);
            padding: 60px 0;
            display: flex;
            justify-content: center;
            align-items: center;
            background: var(--bg-secondary);
        }

        .social-row {
            display: flex;
            gap: 20px;
        }

        .social-btn {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: var(--surface);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            display: grid;
            place-items: center;
            font-size: 1.25rem;
            box-shadow: var(--shadow-sm);
            transition: var(--transition-smooth);
        }

        .social-btn:hover {
            transform: translateY(-6px);
            background: var(--accent-gradient);
            color: #ffffff;
            border-color: transparent;
            box-shadow: 0 8px 24px rgba(217, 119, 6, 0.25);
        }

        /* Footer */
        footer {
            background: var(--surface);
            border-top: 1px solid var(--border-color);
            padding: 40px 0;
            text-align: center;
        }

        footer p {
            font-size: 0.95rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        /* Keyframes */
        @keyframes pulse-blob {
            0% {
                transform: scale(1) translate(0, 0);
            }

            100% {
                transform: scale(1.15) translate(10px, -10px);
            }
        }

        /* Responsive Breakpoints */
        @media (max-width: 1200px) {
            .container {
                padding: 0 32px;
            }

            .hero-grid {
                gap: 40px;
            }

            .services-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @media (max-width: 992px) {
            .section {
                padding: 90px 0;
            }

            .hero-grid {
                grid-template-columns: 1fr;
                gap: 60px;
                text-align: center;
            }

            .hero-copy {
                align-items: center;
            }

            .hero-copy h2 {
                font-size: 3.2rem;
            }

            .hero-copy p {
                margin-left: auto;
                margin-right: auto;
            }

            .stats-grid {
                max-width: 600px;
            }

            .portfolio-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .services-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .contact-grid {
                grid-template-columns: 1fr;
                gap: 50px;
            }
        }

        @media (max-width: 768px) {
            .nav-desktop {
                display: none;
            }

            .nav-toggle {
                display: flex;
            }

            .hero {
                padding-top: 160px;
            }

            .hero-copy h2 {
                font-size: 2.6rem;
            }

            .portfolio-grid {
                grid-template-columns: 1fr;
                max-width: 480px;
                margin-left: auto;
                margin-right: auto;
            }

            .direct-links {
                grid-template-columns: 1fr;
            }

            .contact-form-container {
                padding: 32px;
            }
        }

        @media (max-width: 576px) {
            .container {
                padding: 0 20px;
            }

            .section-title {
                font-size: 2rem;
            }

            .hero-copy h2 {
                font-size: 2.2rem;
            }

            .hero-actions .btn {
                width: 100%;
            }

            .stats-grid {
                grid-template-columns: 1fr;
                gap: 16px;
            }

            .services-grid {
                grid-template-columns: 1fr;
            }

            .brand-stack {
                width: 250px;
                height: 250px;
            }

            .brand-card {
                width: 190px;
                height: 190px;
                padding: 12px;
            }

            /* Adjust hover offsets for smaller cards */
            .brand-stack:hover .brand-card-1 {
                transform: rotateZ(-15deg) translate3d(-60px, -20px, 20px) scale(1.05);
            }

            .brand-stack:hover .brand-card-3 {
                transform: rotateZ(15deg) translate3d(60px, 20px, 20px) scale(1.05);
            }
        }
    
        /* Clients Section */
        .clients-marquee {
            overflow: hidden;
            white-space: nowrap;
            position: relative;
            padding: 40px 0;
            display: flex;
            align-items: center;
            border-top: 1px solid var(--border-color);
            background: var(--surface);
        }

        .clients-marquee-content {
            display: inline-flex;
            align-items: center;
            gap: 80px;
            animation: scroll-clients 30s linear infinite;
            padding-right: 80px;
        }

        .clients-marquee-content img {
            height: 60px;
            width: auto;
            object-fit: contain;
            
            
            transition: var(--transition-smooth);
        }
        
        .clients-marquee-content img:hover {
            transform: scale(1.05);
        }

        @keyframes scroll-clients {
            0% { transform: translateX(0); }
            100% { transform: translateX(calc(-50% - 40px)); }
        }

    </style>

</head>
