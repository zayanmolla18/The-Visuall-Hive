        >
        <a
            href="#clients"
            class="mobile-link text-[1.2rem] font-bold text-slate-900 border-b border-slate-900/10 pb-3 transition-all duration-200 hover:text-amber-600 hover:pl-2"
            >Clients</a
        >
        <a
            href="#contact"
            class="mobile-link text-[1.2rem] font-bold text-slate-900 border-b border-slate-900/10 pb-3 transition-all duration-200 hover:text-amber-600 hover:pl-2"
            >Contact</a
        >
    </div>

    <!-- Hero Section -->
    <section
        class="hero relative py-[200px] lg:pt-[160px] pb-[120px] overflow-hidden bg-hero-gradient"
    >
        <!-- Decorative Canvas Background -->
        <canvas
            id="hero-hex-canvas"
            class="absolute inset-0 w-full h-full pointer-events-none z-0 opacity-80"
            aria-hidden="true"></canvas>
        <!-- Gradient overlay to ensure text readability -->
        <div
            class="absolute inset-0 bg-gradient-to-r from-slate-50 via-slate-50/80 to-transparent pointer-events-none z-[1]"
        >
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const canvas = document.getElementById("hero-hex-canvas");
                if (!canvas) return;
                const ctx = canvas.getContext("2d");

                // Config
                const PARTICLES = window.innerWidth < 768 ? 30 : 85;
                const LINK_DISTANCE = window.innerWidth < 768 ? 120 : 200;
                const MOUSE_RADIUS = 280;

                let width, height;
                let particles = [];
                let mouse = { x: -1000, y: -1000, active: false };

                function init() {
                    width = canvas.width = canvas.parentElement.offsetWidth;
                    height = canvas.height = canvas.parentElement.offsetHeight;

                    particles = [];
                    for (let i = 0; i < PARTICLES; i++) {
                        particles.push({
                            x: Math.random() * width,
                            y: Math.random() * height,
                            vx: (Math.random() - 0.5) * 0.4,
                            vy: (Math.random() - 0.5) * 0.4,
                            size: 4 + Math.random() * 8,
                            rot: Math.random() * Math.PI * 2,
                            rotSpeed: (Math.random() - 0.5) * 0.02,
                            opacity: 0.15 + Math.random() * 0.35,
                        });
                    }
                }

                function drawHexagon(x, y, r, rot, fill, stroke) {
                    ctx.beginPath();
                    for (let i = 0; i < 6; i++) {
                        const angle = (Math.PI / 3) * i + rot;
                        const hx = x + r * Math.cos(angle);
                        const hy = y + r * Math.sin(angle);
                        if (i === 0) ctx.moveTo(hx, hy);
                        else ctx.lineTo(hx, hy);
                    }
                    ctx.closePath();
                    if (stroke) {
                        ctx.strokeStyle = stroke;
                        ctx.lineWidth = 1;
                        ctx.stroke();
                    }
                    if (fill) {
                        ctx.fillStyle = fill;
                        ctx.fill();
                    }
                }

                function animate() {
                    ctx.clearRect(0, 0, width, height);

                    // Update particles
                    particles.forEach((p) => {
                        p.x += p.vx;
                        p.y += p.vy;
                        p.rot += p.rotSpeed;

                        // Wrap around edges for a continuous flowing effect
                        if (p.x < -20) p.x = width + 20;
                        if (p.x > width + 20) p.x = -20;
                        if (p.y < -20) p.y = height + 20;
                        if (p.y > height + 20) p.y = -20;
                    });

                    // Draw links
                    ctx.lineWidth = 0.5;
                    for (let i = 0; i < particles.length; i++) {
                        for (let j = i + 1; j < particles.length; j++) {
                            const dx = particles[i].x - particles[j].x;
                            const dy = particles[i].y - particles[j].y;
                            const dist = Math.sqrt(dx * dx + dy * dy);

                            if (dist < LINK_DISTANCE) {
                                const opacity =
                                    (1 - dist / LINK_DISTANCE) * 0.15;
                                ctx.strokeStyle = `rgba(217, 119, 6, ${opacity})`;
                                ctx.beginPath();
                                ctx.moveTo(particles[i].x, particles[i].y);
                                ctx.lineTo(particles[j].x, particles[j].y);
                                ctx.stroke();
                            }
                        }
                    }

                    // Draw mouse links
                    if (mouse.active) {
                        ctx.lineWidth = 1;
                        for (let p of particles) {
                            const dx = mouse.x - p.x;
                            const dy = mouse.y - p.y;
                            const dist = Math.sqrt(dx * dx + dy * dy);
                            if (dist < MOUSE_RADIUS) {
                                const opacity = (1 - dist / MOUSE_RADIUS) * 0.4;
                                ctx.strokeStyle = `rgba(217, 119, 6, ${opacity})`;
                                ctx.beginPath();
                                ctx.moveTo(mouse.x, mouse.y);
                                ctx.lineTo(p.x, p.y);
                                ctx.stroke();
                            }
                        }
                    }

                    // Draw particles
                    particles.forEach((p) => {
                        let glow = 0;
                        if (mouse.active) {
                            const dist = Math.hypot(
                                mouse.x - p.x,
                                mouse.y - p.y,
                            );
                            if (dist < MOUSE_RADIUS)
                                glow = (1 - dist / MOUSE_RADIUS) * 0.6;
                        }

                        const strokeColor = `rgba(217, 119, 6, ${Math.min(0.9, p.opacity + glow)})`;
                        let fillColor = null;
                        if (p.size > 8) {
                            fillColor = `rgba(217, 119, 6, ${Math.min(0.4, p.opacity * 0.3 + glow * 0.3)})`;
                        }
                        drawHexagon(
                            p.x,
                            p.y,
                            p.size,
                            p.rot,
                            fillColor,
                            strokeColor,
                        );
                    });

                    requestAnimationFrame(animate);
                }

                window.addEventListener("resize", () => {
                    clearTimeout(window.resizeTimeout);
                    window.resizeTimeout = setTimeout(init, 250);
                });

                canvas.parentElement.addEventListener("mousemove", (e) => {
                    const rect = canvas.parentElement.getBoundingClientRect();
                    mouse.x = e.clientX - rect.left;
                    mouse.y = e.clientY - rect.top;
                    mouse.active = true;
                });

                canvas.parentElement.addEventListener("mouseleave", () => {
                    mouse.active = false;
                });

                init();
                animate();
            });
        </script>

        <div class="relative z-10">
            <div
