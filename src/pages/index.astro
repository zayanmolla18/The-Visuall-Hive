                        >
                            <span
                                class="block text-[1.8rem] font-extrabold text-slate-900 mb-1 bg-accent-gradient bg-clip-text text-transparent"
                                >100+</span
                            >
                            <span
                                class="text-[0.85rem] font-semibold text-slate-600 uppercase tracking-[0.05em]"
                                >Projects Delivered</span
                            >
                        </div>
                        <div
                            class="bg-white p-5 clip-chamfer transition-smooth hover:shadow-honey-glow hover:-translate-y-1 hover:shadow-md hover:"
                        >
                            <span
                                class="block text-[1.8rem] font-extrabold text-slate-900 mb-1 bg-accent-gradient bg-clip-text text-transparent"
                                >5+</span
                            >
                            <span
                                class="text-[0.85rem] font-semibold text-slate-600 uppercase tracking-[0.05em]"
                                >Years Experience</span
                            >
                        </div>
                        <div
                            class="bg-white p-5 clip-chamfer transition-smooth hover:shadow-honey-glow hover:-translate-y-1 hover:shadow-md hover:"
                        >
                            <span
                                class="block text-[1.8rem] font-extrabold text-slate-900 mb-1 bg-accent-gradient bg-clip-text text-transparent"
                                >24/7</span
                            >
                            <span
                                class="text-[0.85rem] font-semibold text-slate-600 uppercase tracking-[0.05em]"
                                >Client Support</span
                            >
                        </div>
                    </div>
                </div>
            </div>
        
        
        
<!-- Features Section -->
<section id="features" class="py-[120px] lg:py-[100px] relative overflow-hidden bg-slate-50">
    <div class="max-w-[1280px] mx-auto px-5 xl:px-10 w-full">

