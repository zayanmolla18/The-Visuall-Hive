---
import Layout from '../layouts/Layout.astro';
---

<Layout>


    <!-- Header Navigation -->
    <header id="site-header" class="group fixed top-0 left-0 w-full bg-white/85 backdrop-blur-md border-b border-slate-900/10 z-[1000] transition-all duration-200 [&.scrolled]:bg-white/95 [&.scrolled]:shadow-sm">
        <div class="max-w-[1280px] mx-auto px-5 xl:px-10 w-full flex justify-between items-center h-[90px] transition-all duration-200 group-[.scrolled]:h-[76px]">
            <a href="#" class="flex items-center gap-3">
                <img src="/img/THE VISUAL HIVE TRANSPARENT BG LOGO.png" alt="The Visual Hive logo" class="h-12 w-auto transition-all duration-400 group-[.scrolled]:h-[42px]" >
                <h1 class="text-[1.2rem] font-extrabold tracking-tight text-slate-900">The Visual Hive</h1>
            </a>

            <nav class="hidden md:flex items-center gap-9">
                <a href="#" class="nav-link active-link font-semibold text-[0.95rem] text-slate-600 relative py-2 transition-colors hover:text-slate-900 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-amber-600 after:transition-all after:duration-200 hover:after:w-full [&.active-link]:text-slate-900 [&.active-link]:after:w-full">Home</a>
                <a href="#services" class="nav-link font-semibold text-[0.95rem] text-slate-600 relative py-2 transition-colors hover:text-slate-900 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-amber-600 after:transition-all after:duration-200 hover:after:w-full [&.active-link]:text-slate-900 [&.active-link]:after:w-full">Services</a>
                <a href="#work" class="nav-link font-semibold text-[0.95rem] text-slate-600 relative py-2 transition-colors hover:text-slate-900 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-amber-600 after:transition-all after:duration-200 hover:after:w-full [&.active-link]:text-slate-900 [&.active-link]:after:w-full">Portfolio</a>
                <a href="#clients" class="nav-link font-semibold text-[0.95rem] text-slate-600 relative py-2 transition-colors hover:text-slate-900 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-amber-600 after:transition-all after:duration-200 hover:after:w-full [&.active-link]:text-slate-900 [&.active-link]:after:w-full">Clients</a>
                <a href="#contact" class="nav-link font-semibold text-[0.95rem] text-slate-600 relative py-2 transition-colors hover:text-slate-900 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-amber-600 after:transition-all after:duration-200 hover:after:w-full [&.active-link]:text-slate-900 [&.active-link]:after:w-full">Contact</a>
            </nav>

            <button class="nav-toggle flex md:hidden flex-col justify-between w-6 h-[18px] bg-transparent border-none cursor-pointer z-[1100] group/toggle" id="menu-toggle" aria-label="Toggle navigation menu">
                <span class="w-full h-[2px] bg-slate-900 rounded-sm transition-all duration-400 group-[.open]/toggle:translate-y-[8px] group-[.open]/toggle:rotate-45"></span>
                <span class="w-full h-[2px] bg-slate-900 rounded-sm transition-all duration-400 group-[.open]/toggle:opacity-0"></span>
                <span class="w-full h-[2px] bg-slate-900 rounded-sm transition-all duration-400 group-[.open]/toggle:-translate-y-[8px] group-[.open]/toggle:-rotate-45"></span>
            </button>
        </div>
    </header>

    <!-- Mobile Navigation Drawer -->
    <div class="overlay fixed inset-0 w-screen h-screen bg-slate-900/40 backdrop-blur-sm z-[1020] opacity-0 pointer-events-none transition-opacity duration-400 ease-in [&.open]:opacity-100 [&.open]:pointer-events-auto" id="menu-overlay"></div>
    <div class="nav-drawer fixed top-0 -right-[100%] w-[300px] h-screen bg-white shadow-[-10px_0_40px_rgba(15,23,42,0.15)] z-[1050] flex flex-col pt-[120px] px-10 pb-10 gap-7 transition-[right] duration-[400ms] ease-smooth [&.open]:right-0" id="mobile-drawer">
        <a href="#" class="mobile-link text-[1.2rem] font-bold text-slate-900 border-b border-slate-900/10 pb-3 transition-all duration-200 hover:text-amber-600 hover:pl-2">Home</a>
        <a href="#services" class="mobile-link text-[1.2rem] font-bold text-slate-900 border-b border-slate-900/10 pb-3 transition-all duration-200 hover:text-amber-600 hover:pl-2">Services</a>
        <a href="#work" class="mobile-link text-[1.2rem] font-bold text-slate-900 border-b border-slate-900/10 pb-3 transition-all duration-200 hover:text-amber-600 hover:pl-2">Portfolio</a>
        <a href="#clients" class="mobile-link text-[1.2rem] font-bold text-slate-900 border-b border-slate-900/10 pb-3 transition-all duration-200 hover:text-amber-600 hover:pl-2">Clients</a>
        <a href="#contact" class="mobile-link text-[1.2rem] font-bold text-slate-900 border-b border-slate-900/10 pb-3 transition-all duration-200 hover:text-amber-600 hover:pl-2">Contact</a>
    </div>

    <!-- Hero Section -->
    <section class="hero py-[200px] lg:pt-[160px] pb-[120px] overflow-hidden bg-hero-gradient">
        <div class="max-w-[1280px] mx-auto px-5 xl:px-10 w-full grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-16 items-center text-center lg:text-left">
            <div class="hero-copy reveal flex flex-col items-center lg:items-start">
                <div class="bg-glow-gradient border border-border-hover text-amber-600 py-2 px-[18px] rounded-full text-[0.8rem] font-bold uppercase tracking-[0.12em] mb-6 inline-flex items-center gap-2">
                    <i class="fas fa-sparkles"></i> Creative Brand Strategy & Visual Storytelling
                </div>
                <h2 class="text-[2.2rem] sm:text-[2.6rem] lg:text-[min(3.8rem,5vw)] leading-[1.1] font-extrabold tracking-[-0.03em] text-slate-900 mb-6 flex flex-wrap gap-[0.3em] items-center justify-center lg:justify-start">
                    Design that builds 
                    <span class="text-slider">
                        <span class="text-slider-inner animate-text-slide">
                            <span class="bg-gradient-to-br from-slate-800 to-amber-400 bg-clip-text text-transparent h-[1.1em] inline-flex items-center whitespace-nowrap">powerful brands</span>
                            <span class="bg-gradient-to-br from-slate-800 to-amber-400 bg-clip-text text-transparent h-[1.1em] inline-flex items-center whitespace-nowrap">digital experiences</span>
                            <span class="bg-gradient-to-br from-slate-800 to-amber-400 bg-clip-text text-transparent h-[1.1em] inline-flex items-center whitespace-nowrap">modern identities</span>
                            <span class="bg-gradient-to-br from-slate-800 to-amber-400 bg-clip-text text-transparent h-[1.1em] inline-flex items-center whitespace-nowrap">impactful marketing</span>
                            <span class="bg-gradient-to-br from-slate-800 to-amber-400 bg-clip-text text-transparent h-[1.1em] inline-flex items-center whitespace-nowrap">powerful brands</span>
                        </span>
                    </span>
                </h2>
                <p class="text-[1.15rem] leading-[1.8] text-slate-600 mb-9 max-w-[580px] mx-auto lg:mx-0">We craft polished identities, marketing materials, and digital experiences that elevate businesses,
                    capture attention, and drive meaningful growth.</p>
                <div class="flex gap-4 flex-wrap mb-12 w-full justify-center lg:justify-start max-sm:flex-col">
                    <a href="#contact" class="inline-flex items-center justify-center gap-[10px] py-4 px-8 rounded-full font-bold text-[0.95rem] transition-smooth cursor-pointer border-none bg-accent-gradient text-white shadow-[0_8px_24px_rgba(217,119,6,0.2)] hover:-translate-y-0.5 hover:shadow-[0_12px_30px_rgba(217,119,6,0.3)]"><i class="fas fa-paper-plane"></i>Start a project</a>
                    <a href="#work" class="inline-flex items-center justify-center gap-[10px] py-4 px-8 rounded-full font-bold text-[0.95rem] transition-smooth cursor-pointer bg-white border border-border-color text-slate-900 hover:bg-slate-100 hover:-translate-y-0.5">Explore Work</a>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5 w-full max-w-[600px] lg:max-w-full mx-auto lg:mx-0">
                    <div class="bg-white border border-border-color p-5 rounded-2xl shadow-sm transition-smooth hover:-translate-y-1 hover:shadow-md hover:border-border-hover">
                        <span class="block text-[1.8rem] font-extrabold text-slate-900 mb-1 bg-accent-gradient bg-clip-text text-transparent">100+</span>
                        <span class="text-[0.85rem] font-semibold text-slate-600 uppercase tracking-[0.05em]">Projects Delivered</span>
                    </div>
                    <div class="bg-white border border-border-color p-5 rounded-2xl shadow-sm transition-smooth hover:-translate-y-1 hover:shadow-md hover:border-border-hover">
                        <span class="block text-[1.8rem] font-extrabold text-slate-900 mb-1 bg-accent-gradient bg-clip-text text-transparent">5+</span>
                        <span class="text-[0.85rem] font-semibold text-slate-600 uppercase tracking-[0.05em]">Years Experience</span>
                    </div>
                    <div class="bg-white border border-border-color p-5 rounded-2xl shadow-sm transition-smooth hover:-translate-y-1 hover:shadow-md hover:border-border-hover">
                        <span class="block text-[1.8rem] font-extrabold text-slate-900 mb-1 bg-accent-gradient bg-clip-text text-transparent">24/7</span>
                        <span class="text-[0.85rem] font-semibold text-slate-600 uppercase tracking-[0.05em]">Client Support</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Marquee Section -->
    <div class="bg-slate-800 text-white py-5 overflow-hidden whitespace-nowrap relative flex items-center border-y border-white/10">
        <div class="inline-flex items-center gap-6 animate-scroll-marquee pr-6">
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">BRAND IDENTITY</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">LOGO DESIGN</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">VISUAL STORYTELLING</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">SOCIAL MEDIA GRAPHICS</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">CREATIVE STRATEGY</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">PRINT MEDIA</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">UI/UX DESIGN</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">MARKETING MATERIALS</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
            <!-- duplicate for smooth scrolling -->
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">BRAND IDENTITY</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">LOGO DESIGN</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">VISUAL STORYTELLING</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">SOCIAL MEDIA GRAPHICS</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">CREATIVE STRATEGY</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">PRINT MEDIA</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">UI/UX DESIGN</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
            <span class="text-[1.15rem] font-bold tracking-[0.15em] uppercase">MARKETING MATERIALS</span><span class="text-amber-600 text-[1.5rem] leading-none">•</span>
        </div>
    </div>



    <!-- Services Section -->
    <section id="services" class="py-[120px] lg:py-[90px] relative">
        <div class="max-w-[1280px] mx-auto px-5 xl:px-10 w-full">
            <div class="text-center max-w-[680px] mx-auto mb-16 reveal">
                <span class="inline-block text-[0.8rem] font-bold uppercase tracking-[0.15em] text-amber-600 mb-3">Services</span>
                <h2 class="text-[2rem] sm:text-[2.5rem] font-extrabold tracking-tight text-slate-900 mb-5">Creative Capabilities</h2>
                <p class="text-[1.1rem] text-slate-600 leading-relaxed">From core visual identity systems to specialized digital items, we provide
                    full-spectrum design solutions that make your business stand out.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <!-- 01 Logo Design -->
                <div class="group bg-white border border-border-color rounded-3xl p-8 transition-smooth relative overflow-hidden flex flex-col min-h-[260px] hover:-translate-y-1.5 hover:shadow-hover hover:border-border-hover after:content-[''] after:absolute after:top-0 after:left-0 after:w-full after:h-1 after:bg-accent-gradient after:scale-x-0 after:origin-left after:transition-transform after:duration-400 hover:after:scale-x-100 reveal">
                    <div class="flex justify-between items-start mb-6">
                        <div class="w-[52px] h-[52px] rounded-2xl grid place-items-center bg-amber-600/10 text-amber-600 text-[1.25rem] transition-smooth group-hover:bg-accent-gradient group-hover:text-white group-hover:scale-105"><i class="fas fa-palette"></i></div>
                    </div>
                    <h3 class="text-[1.15rem] font-extrabold text-slate-900 mb-3 tracking-[-0.01em]">Logo Design</h3>
                    <p class="text-[0.95rem] text-slate-600 leading-relaxed">Memorable logos and brand marks designed for maximum clarity, versatility, and scalability.</p>
                </div>

                <!-- 02 Branding -->
                <div class="group bg-white border border-border-color rounded-3xl p-8 transition-smooth relative overflow-hidden flex flex-col min-h-[260px] hover:-translate-y-1.5 hover:shadow-hover hover:border-border-hover after:content-[''] after:absolute after:top-0 after:left-0 after:w-full after:h-1 after:bg-accent-gradient after:scale-x-0 after:origin-left after:transition-transform after:duration-400 hover:after:scale-x-100 reveal">
                    <div class="flex justify-between items-start mb-6">
                        <div class="w-[52px] h-[52px] rounded-2xl grid place-items-center bg-amber-600/10 text-amber-600 text-[1.25rem] transition-smooth group-hover:bg-accent-gradient group-hover:text-white group-hover:scale-105"><i class="fas fa-bullhorn"></i></div>
                    </div>
                    <h3 class="text-[1.15rem] font-extrabold text-slate-900 mb-3 tracking-[-0.01em]">Brand Identity</h3>
                    <p class="text-[0.95rem] text-slate-600 leading-relaxed">Complete design guideline systems ensuring consistent typography, colors, and styling across all
                        touchpoints.</p>
                </div>

                <!-- 03 Business Cards -->
                <div class="group bg-white border border-border-color rounded-3xl p-8 transition-smooth relative overflow-hidden flex flex-col min-h-[260px] hover:-translate-y-1.5 hover:shadow-hover hover:border-border-hover after:content-[''] after:absolute after:top-0 after:left-0 after:w-full after:h-1 after:bg-accent-gradient after:scale-x-0 after:origin-left after:transition-transform after:duration-400 hover:after:scale-x-100 reveal">
                    <div class="flex justify-between items-start mb-6">
                        <div class="w-[52px] h-[52px] rounded-2xl grid place-items-center bg-amber-600/10 text-amber-600 text-[1.25rem] transition-smooth group-hover:bg-accent-gradient group-hover:text-white group-hover:scale-105"><i class="fas fa-id-card"></i></div>
                    </div>
                    <h3 class="text-[1.15rem] font-extrabold text-slate-900 mb-3 tracking-[-0.01em]">Business Cards</h3>
                    <p class="text-[0.95rem] text-slate-600 leading-relaxed">Premium print-ready business cards styled to establish authority and leave lasting impressions.
                    </p>
                </div>

                <!-- 04 Invitation Design -->
                <div class="group bg-white border border-border-color rounded-3xl p-8 transition-smooth relative overflow-hidden flex flex-col min-h-[260px] hover:-translate-y-1.5 hover:shadow-hover hover:border-border-hover after:content-[''] after:absolute after:top-0 after:left-0 after:w-full after:h-1 after:bg-accent-gradient after:scale-x-0 after:origin-left after:transition-transform after:duration-400 hover:after:scale-x-100 reveal">
                    <div class="flex justify-between items-start mb-6">
                        <div class="w-[52px] h-[52px] rounded-2xl grid place-items-center bg-amber-600/10 text-amber-600 text-[1.25rem] transition-smooth group-hover:bg-accent-gradient group-hover:text-white group-hover:scale-105"><i class="fas fa-envelope-open-text"></i></div>
                    </div>
                    <h3 class="text-[1.15rem] font-extrabold text-slate-900 mb-3 tracking-[-0.01em]">Event Invitations</h3>
                    <p class="text-[0.95rem] text-slate-600 leading-relaxed">Custom, elegant stationary layouts designed for events, store openings, and special corporate
                        launches.</p>
                </div>

                <!-- 05 Mockups & Presentations -->
                <div class="group bg-white border border-border-color rounded-3xl p-8 transition-smooth relative overflow-hidden flex flex-col min-h-[260px] hover:-translate-y-1.5 hover:shadow-hover hover:border-border-hover after:content-[''] after:absolute after:top-0 after:left-0 after:w-full after:h-1 after:bg-accent-gradient after:scale-x-0 after:origin-left after:transition-transform after:duration-400 hover:after:scale-x-100 reveal">
                    <div class="flex justify-between items-start mb-6">
                        <div class="w-[52px] h-[52px] rounded-2xl grid place-items-center bg-amber-600/10 text-amber-600 text-[1.25rem] transition-smooth group-hover:bg-accent-gradient group-hover:text-white group-hover:scale-105"><i class="fas fa-images"></i></div>
                    </div>
                    <h3 class="text-[1.15rem] font-extrabold text-slate-900 mb-3 tracking-[-0.01em]">Creative Mockups</h3>
                    <p class="text-[0.95rem] text-slate-600 leading-relaxed">High-end corporate visualization files demonstrating your branding in real-world environments.
                    </p>
                </div>

                <!-- 06 Invoice & Stationary -->
                <div class="group bg-white border border-border-color rounded-3xl p-8 transition-smooth relative overflow-hidden flex flex-col min-h-[260px] hover:-translate-y-1.5 hover:shadow-hover hover:border-border-hover after:content-[''] after:absolute after:top-0 after:left-0 after:w-full after:h-1 after:bg-accent-gradient after:scale-x-0 after:origin-left after:transition-transform after:duration-400 hover:after:scale-x-100 reveal">
                    <div class="flex justify-between items-start mb-6">
                        <div class="w-[52px] h-[52px] rounded-2xl grid place-items-center bg-amber-600/10 text-amber-600 text-[1.25rem] transition-smooth group-hover:bg-accent-gradient group-hover:text-white group-hover:scale-105"><i class="fas fa-file-invoice-dollar"></i></div>
                    </div>
                    <h3 class="text-[1.15rem] font-extrabold text-slate-900 mb-3 tracking-[-0.01em]">Billing Designs</h3>
                    <p class="text-[0.95rem] text-slate-600 leading-relaxed">Professional layout solutions for receipts, invoices, and letterheads to convey trust and
                        systemization.</p>
                </div>

                <!-- 07 Product Tags -->
                <div class="group bg-white border border-border-color rounded-3xl p-8 transition-smooth relative overflow-hidden flex flex-col min-h-[260px] hover:-translate-y-1.5 hover:shadow-hover hover:border-border-hover after:content-[''] after:absolute after:top-0 after:left-0 after:w-full after:h-1 after:bg-accent-gradient after:scale-x-0 after:origin-left after:transition-transform after:duration-400 hover:after:scale-x-100 reveal">
                    <div class="flex justify-between items-start mb-6">
                        <div class="w-[52px] h-[52px] rounded-2xl grid place-items-center bg-amber-600/10 text-amber-600 text-[1.25rem] transition-smooth group-hover:bg-accent-gradient group-hover:text-white group-hover:scale-105"><i class="fas fa-tag"></i></div>
                    </div>
                    <h3 class="text-[1.15rem] font-extrabold text-slate-900 mb-3 tracking-[-0.01em]">Product Tags</h3>
                    <p class="text-[0.95rem] text-slate-600 leading-relaxed">Clean label templates and product tagging solutions optimized for printing and display
                        aesthetics.</p>
                </div>

                <!-- 08 Video Editing -->
                <div class="group bg-white border border-border-color rounded-3xl p-8 transition-smooth relative overflow-hidden flex flex-col min-h-[260px] hover:-translate-y-1.5 hover:shadow-hover hover:border-border-hover after:content-[''] after:absolute after:top-0 after:left-0 after:w-full after:h-1 after:bg-accent-gradient after:scale-x-0 after:origin-left after:transition-transform after:duration-400 hover:after:scale-x-100 reveal">
                    <div class="flex justify-between items-start mb-6">
                        <div class="w-[52px] h-[52px] rounded-2xl grid place-items-center bg-amber-600/10 text-amber-600 text-[1.25rem] transition-smooth group-hover:bg-accent-gradient group-hover:text-white group-hover:scale-105"><i class="fas fa-video"></i></div>
                    </div>
                    <h3 class="text-[1.15rem] font-extrabold text-slate-900 mb-3 tracking-[-0.01em]">Video Editing</h3>
                    <p class="text-[0.95rem] text-slate-600 leading-relaxed">High-energy visual pacing, edits, and cuts styled for optimal audience retention on social
                        networks.</p>
                </div>

                <!-- 09 Web Design -->
                <div class="group bg-white border border-border-color rounded-3xl p-8 transition-smooth relative overflow-hidden flex flex-col min-h-[260px] hover:-translate-y-1.5 hover:shadow-hover hover:border-border-hover after:content-[''] after:absolute after:top-0 after:left-0 after:w-full after:h-1 after:bg-accent-gradient after:scale-x-0 after:origin-left after:transition-transform after:duration-400 hover:after:scale-x-100 reveal">
                    <div class="flex justify-between items-start mb-6">
                        <div class="w-[52px] h-[52px] rounded-2xl grid place-items-center bg-amber-600/10 text-amber-600 text-[1.25rem] transition-smooth group-hover:bg-accent-gradient group-hover:text-white group-hover:scale-105"><i class="fas fa-globe"></i></div>
                    </div>
                    <h3 class="text-[1.15rem] font-extrabold text-slate-900 mb-3 tracking-[-0.01em]">Website Design</h3>
                    <p class="text-[0.95rem] text-slate-600 leading-relaxed">Modern user interfaces designed with strict layout grids, clear navigation hierarchies, and
                        responsive paths.</p>
                </div>

                <!-- 10 Social Media Covers -->
                <div class="group bg-white border border-border-color rounded-3xl p-8 transition-smooth relative overflow-hidden flex flex-col min-h-[260px] hover:-translate-y-1.5 hover:shadow-hover hover:border-border-hover after:content-[''] after:absolute after:top-0 after:left-0 after:w-full after:h-1 after:bg-accent-gradient after:scale-x-0 after:origin-left after:transition-transform after:duration-400 hover:after:scale-x-100 reveal">
                    <div class="flex justify-between items-start mb-6">
                        <div class="w-[52px] h-[52px] rounded-2xl grid place-items-center bg-amber-600/10 text-amber-600 text-[1.25rem] transition-smooth group-hover:bg-accent-gradient group-hover:text-white group-hover:scale-105"><i class="fab fa-facebook-f"></i></div>
                    </div>
                    <h3 class="text-[1.15rem] font-extrabold text-slate-900 mb-3 tracking-[-0.01em]">Social Banners</h3>
                    <p class="text-[0.95rem] text-slate-600 leading-relaxed">Stunning cover designs tailored to fit header structures across YouTube, Facebook, and Instagram.
                    </p>
