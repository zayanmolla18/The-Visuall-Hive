                                >
                                <span
                                    class="bg-gradient-to-br from-slate-800 to-amber-400 bg-clip-text text-transparent h-[1.1em] inline-flex items-center whitespace-nowrap"
                                    >drives revenue</span
                                >
                                <span
                                    class="bg-gradient-to-br from-slate-800 to-amber-400 bg-clip-text text-transparent h-[1.1em] inline-flex items-center whitespace-nowrap"
                                    >builds brands</span
