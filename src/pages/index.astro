                            ><i class="fas fa-paper-plane"></i>Start a project</a
                        >
                        <a
                            href="#work"
                            class="inline-flex items-center justify-center gap-[10px] py-4 px-8 clip-chamfer font-bold text-[0.95rem] transition-smooth cursor-pointer bg-amber-600 text-white hover:shadow-honey-glow hover:-translate-y-0.5"
